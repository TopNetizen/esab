{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pkpm.example/schemas/abaqus-result-evidence-1.0.json",
  "title": "Abaqus result evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "solver"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provenance": {
      "type": "object",
      "required": [
        "odb_paths",
        "step",
        "frames",
        "regions",
        "coordinate_system",
        "position",
        "averaging",
        "extractor"
      ],
      "properties": {
        "odb_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "job_name": {"type": "string"},
        "step": {"type": "string"},
        "frames": {"type": "array", "minItems": 1},
        "regions": {"type": "object"},
        "coordinate_system": {"type": "string"},
        "position": {"type": "string"},
        "averaging": {"type": "string"},
        "extractor": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "solver": {
      "type": "object",
      "required": ["terminal_state", "analysis_errors", "analysis_warnings"],
      "properties": {
        "terminal_state": {"type": "string"},
        "analysis_errors": {"type": "integer", "minimum": 0},
        "analysis_warnings": {"type": "integer", "minimum": 0},
        "diagnostic_lines": {"type": "array", "items": {"type": "string"}}
      }
    },
    "environment_limitations": {
      "type": "array",
      "items": {"$ref": "#/$defs/environmentLimitation"}
    },
    "equilibrium": {
      "type": "object",
      "required": [
        "applied_force",
        "reaction_force",
        "applied_moment",
        "reaction_moment",
        "reference_point",
        "force_criterion_id",
        "moment_criterion_id"
      ],
      "properties": {
        "applied_force": {"$ref": "#/$defs/vector3"},
        "reaction_force": {"$ref": "#/$defs/vector3"},
        "applied_moment": {"$ref": "#/$defs/vector3"},
        "reaction_moment": {"$ref": "#/$defs/vector3"},
        "reference_point": {"$ref": "#/$defs/vector3"},
        "characteristic_force": {"type": "number", "exclusiveMinimum": 0},
        "characteristic_moment": {"type": "number", "exclusiveMinimum": 0},
        "force_criterion_id": {"type": "string"},
        "moment_criterion_id": {"type": "string"}
      }
    },
    "energy": {
      "type": "object",
      "required": ["series", "criteria"],
      "properties": {
        "series": {"type": "object"},
        "criteria": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "contact": {
      "type": "object",
      "required": ["expected_state", "available_outputs", "total_count", "active_count"],
      "properties": {
        "expected_state": {"enum": ["engaged", "separated", "mixed"]},
        "available_outputs": {"type": "array", "items": {"type": "string"}},
        "total_count": {"type": "integer", "minimum": 0},
        "active_count": {"type": "integer", "minimum": 0},
        "max_penetration": {"type": "number", "minimum": 0},
        "max_slip": {"type": "number", "minimum": 0},
        "max_pressure": {"type": "number"},
        "criteria": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "stress_singularity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["region", "raw_metric", "robust_metric", "samples", "criterion_id"],
        "properties": {
          "region": {"type": "string"},
          "raw_metric": {"type": "string"},
          "robust_metric": {"type": "string"},
          "criterion_id": {"type": "string"},
          "samples": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["mesh_size", "raw_max", "robust_value"],
              "properties": {
                "mesh_size": {"type": "number", "exclusiveMinimum": 0},
                "raw_max": {"type": "number"},
                "robust_value": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "mesh_convergence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "samples", "criterion_id"],
        "properties": {
          "metric": {"type": "string"},
          "unit": {"type": "string"},
          "region": {"type": "string"},
          "criterion_id": {"type": "string"},
          "samples": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["mesh_size", "value"],
              "properties": {
                "mesh_size": {"type": "number", "exclusiveMinimum": 0},
                "value": {"type": "number"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "environmentLimitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_ids",
        "capability",
        "reason",
        "environment",
        "attempts",
        "alternative_evidence"
      ],
      "properties": {
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "capability": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object",
          "additionalProperties": true,
          "required": ["abaqus_version", "runtime_mode"],
          "properties": {
            "abaqus_version": {"type": "string", "minLength": 1},
            "runtime_mode": {"type": "string", "minLength": 1}
          }
        },
        "attempts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configuration", "result", "diagnostic"],
            "properties": {
              "configuration": {"type": "string", "minLength": 1},
              "result": {"type": "string", "minLength": 1},
              "diagnostic": {"type": "string", "minLength": 1}
            }
          }
        },
        "alternative_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    }
  }
}
